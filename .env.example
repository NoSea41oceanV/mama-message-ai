# External providers are optional in the current demo build.
# Keep every secret on the server. Never expose these values to public/app.js.
#
# ================================================================
# [現行主構成を実接続する場所]
# 1. ORCAROUTER_API_KEY        -> 必須（返答・安全判定）
# 2. ROUTER_PROVIDER           -> orcarouter に変更
# 3. VOICE_CLONING_PROVIDER    -> elevenlabs に変更（録音からクローン作成）
# 4. SPEECH_PROVIDER           -> elevenlabs に変更（返答の本人声TTS）
# 5. ELEVENLABS_API_KEY        -> 必須（クローン作成・本人声TTS）
# 6. VIDEO_GENERATION_PROVIDER -> tavus に変更（主動画経路）
# 7. TAVUS_API_KEY / TAVUS_PAL_ID / TAVUS_FACE_ID を設定
# 8. GUARDIAN_VIEW_ACCESS_CODE -> 離れた大人の確認画面に必須
#
# ELEVENLABS_VOICE_ID / ELEVENLABS_VOICE_PROFILE_ID は、アプリ画面から
# クローンを作る場合は空欄のままにしてください。
# 本人FaceをAPI作成する場合だけ、公開HTTPSのTAVUS_PUBLIC_BASE_URLも必要です。
# OpenAI Custom Voice、LiveAvatar、HeyGen、D-ID、Klingは任意・代替・旧経路です。
# ================================================================

# [必須 1/4] OrcaRouterの秘密キー
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
# A small structured-output model keeps child-facing replies responsive.
ORCAROUTER_MODEL=openai/gpt-5.6-luna
# Luna is the primary. Terra keeps the child-facing flow responsive when Luna is unavailable.
ORCAROUTER_FALLBACK_MODEL=openai/gpt-5.6-terra
ORCAROUTER_PRIMARY_TIMEOUT_SECONDS=5
ORCAROUTER_TIMEOUT_SECONDS=25
# [必須 2/4] 実接続では demo を orcarouter に変更
ROUTER_PROVIDER=demo
CONVERSATION_TTL_MINUTES=120

STT_API_KEY=
STT_PROVIDER=demo
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=gpt-4o-mini-transcribe

# Guardian voice sample -> ElevenLabs Instant Voice Clone and Japanese TTS.
VOICE_CLONING_PROVIDER=disabled
# Reply TTS provider. Set to elevenlabs together with VOICE_CLONING_PROVIDER
# when the app should create a clone and speak replies with that voice.
SPEECH_PROVIDER=disabled
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_SECONDS=45
# Preserve the sample's cadence and expression without making speech unstable.
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.85
ELEVENLABS_STYLE=0.2
ELEVENLABS_SPEAKER_BOOST=true

MEDIA_API_KEY=
MEDIA_PROVIDER=demo
PREGENERATED_VIDEO_URL=

# Registered guardian photo -> Tavus Face, HeyGen Photo Avatar, D-ID, or Kling image-to-video.
# Disabled avoids external uploads and provider charges by default.
# Main path: tavus. Keep disabled for a key-free demo.
VIDEO_GENERATION_PROVIDER=disabled
# HeyGen Photo Avatar + reply-specific ElevenLabs audio, facial expression, and hand gestures.
HEYGEN_API_KEY=
HEYGEN_BASE_URL=https://api.heygen.com
HEYGEN_AVATAR_ENGINE=avatar_iv
HEYGEN_RESPONSE_TIMEOUT_SECONDS=180
HEYGEN_POLL_INTERVAL_SECONDS=5

# Real-time avatar. LITE keeps this app's STT, LLM, and ElevenLabs voice.
# Sandbox uses LiveAvatar's public Wayne avatar without consuming credits.
LIVEAVATAR_API_KEY=
LIVEAVATAR_BASE_URL=https://api.liveavatar.com
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_SANDBOX=true
LIVEAVATAR_MAX_SESSION_DURATION_SECONDS=60
LIVEAVATAR_REQUEST_TIMEOUT_SECONDS=20

# Tavus Echo mode keeps this app's STT, LLM, and ElevenLabs voice while Tavus
# renders the face in a private Daily room. TAVUS_FACE_ID may be a stock Face.
TAVUS_API_KEY=
TAVUS_BASE_URL=https://tavusapi.com
TAVUS_PAL_ID=
TAVUS_FACE_ID=
TAVUS_TRAINING_VOICE_NAME=anna
TAVUS_REQUEST_TIMEOUT_SECONDS=20
TAVUS_MAX_CALL_DURATION_SECONDS=300
TAVUS_FACE_POLL_TIMEOUT_SECONDS=18000
# Required only for self-service Face creation. It must be the public HTTPS
# origin serving this app so Tavus can fetch the short-lived training image.
TAVUS_PUBLIC_BASE_URL=
TAVUS_TRAINING_ASSET_TTL_SECONDS=1800
# D-ID Studio > Account settings > API key. Paste API_USERNAME:API_PASSWORD as issued;
# an already-prefixed "Basic ..." value is also accepted. Trial credits are limited,
# and videos generated on the trial have a D-ID watermark.
# Legacy compatibility only: fill this only when explicitly testing D-ID.
DID_API_KEY=
DID_BASE_URL=https://api.d-id.com
# Provider-neutral limits. The KLING_* names below remain supported as fallbacks.
VIDEO_REQUEST_TIMEOUT_SECONDS=30
VIDEO_POLL_INTERVAL_SECONDS=5
VIDEO_POLL_TIMEOUT_SECONDS=600
VIDEO_DOWNLOAD_TIMEOUT_SECONDS=30
# Enforced before encrypted at-rest storage (25 MiB).
VIDEO_MAX_BYTES=26214400

# OrcaRouter Kling settings (used when VIDEO_GENERATION_PROVIDER=kling).
KLING_VIDEO_MODEL=kling/kling-v3
KLING_VIDEO_MODE=std
KLING_VIDEO_DURATION_SECONDS=5
KLING_VIDEO_REQUEST_TIMEOUT_SECONDS=30
KLING_VIDEO_POLL_INTERVAL_SECONDS=5
KLING_VIDEO_POLL_TIMEOUT_SECONDS=600
KLING_VIDEO_DOWNLOAD_TIMEOUT_SECONDS=30
KLING_VIDEO_MAX_BYTES=26214400

# Optional: 32-byte base64/64-char hex key for persistent guardian samples.
# When empty, a local key is generated under the gitignored .data directory.
SAMPLING_ENCRYPTION_KEY=

# Remote guardian chat view. The child screen issues a six-digit pairing code
# valid for 10 minutes; the adult must also enter this private code.
# Demo mode falls back to 2468 only when this value is empty.
GUARDIAN_VIEW_ACCESS_CODE=
# Keep 127.0.0.1 for one PC. Use 0.0.0.0 only on a trusted LAN or deployment.
HOST=127.0.0.1

# Recommended MVP limits from the requirements deck.
MAX_RECORDING_SECONDS=15
# The response flow reserves time for routing; media is capped at 18 seconds.
MEDIA_TIMEOUT_SECONDS=18
TECHNICAL_LOG_TTL_HOURS=24
