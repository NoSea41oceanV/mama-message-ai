* text=auto

# Keep source and documentation consistent across Windows/macOS/Linux.
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env.example text eol=lf
*.ps1 text eol=crlf

# Binary assets and deliverables must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.wav binary
*.mp3 binary
*.webm binary
*.mp4 binary
*.pdf binary
*.pptx binary
*.docx binary
