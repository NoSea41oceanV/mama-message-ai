{
  "name": "guardian-ai-message",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:liveavatar-sdk": "esbuild node_modules/@heygen/liveavatar-web-sdk/lib/index.esm.js --bundle --format=iife --global-name=LiveAvatarSDK --platform=browser --target=es2022 --minify --outfile=public/vendor/liveavatar-sdk.js",
    "prestart": "npm run build:liveavatar-sdk",
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test",
    "video:serve": "node scripts/render-demo-video.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@heygen/liveavatar-web-sdk": "^0.0.18",
    "esbuild": "^0.25.9",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "sharp": "^0.35.3"
  }
}
